    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Misar AI <support@misar.io>",
  "homepage": "https://reach.misar.io/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaradmin/misarreach-sdk-js.git"
  },
  "bugs": {
    "url": "https://reach.misar.io/contact"
  },
  "keywords": [
    "misarreach",
    "outreach",
    "lead-finder",
    "crm",
    "pipeline",
    "sdk",
    "typescript",
    "api-client"
