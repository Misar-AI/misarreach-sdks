{
  "name": "@misarreach/sdk",
  "version": "5.0.3",
  "description": "Typed client for MisarReach outreach & lead generation: a 23-source lead finder with SSE job streaming, contacts/deals/pipeline CRM, multi-channel campaigns, AI sales agent, autopilot and plan-usage reporting.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsc && node --test \"dist/__tests__/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Misar AI <hello@misar.io>",
  "homepage": "https://www.misarreach.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misarreach-sdks.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Misar-AI/misarreach-sdks/issues"
  },
  "keywords": [
    "misarreach",
    "outreach",
    "lead-generation",
    "lead-finder",
    "prospecting",
    "sales-engagement",
    "cold-email",
    "crm",
    "pipeline",
    "campaigns",
    "sales-automation",
    "email-verification",
    "sse",
    "sdk",
    "typescript",
    "api-client"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
