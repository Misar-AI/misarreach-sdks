<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Misar.Reach</RootNamespace>
    <AssemblyName>MisarReach</AssemblyName>

    <!-- NuGet metadata -->
    <PackageId>Misar.Reach</PackageId>
    <Version>5.0.2</Version>
    <Authors>Misar AI</Authors>
    <Company>Misar AI Technology Pvt Ltd</Company>
    <Copyright>Copyright (c) Misar AI</Copyright>
    <Description>Async .NET client for the MisarReach outreach API: lead finder across 23 sources, CRM contacts, deals and pipeline, multi-step campaigns over email, SMS, WhatsApp, web push and social DMs, plus an AI sales agent and autopilot. 94 methods on one MisarReachClient cover every documented endpoint. Server-Sent Events carry live lead-search progress and synthesise a terminal event for a job that already finished; plan caps surface as a typed UpgradeRequiredException (HTTP 402, upgrade:true) that is never retried, while genuinely transient statuses retry with exponential back-off. Authenticates with an mrk_ key; targets net8.0 on System.Text.Json with no third-party dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.misarreach.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Misar-AI/misarreach-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageDocumentationUrl>https://docs.misar.io/reach</PackageDocumentationUrl>
    <PackageTags>misarreach;lead-generation;outreach;sales-engagement;crm;sales-automation;email-marketing;sms;whatsapp;cold-email;api-client;rest-client;server-sent-events;sse</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Tests/ is its own project and references xUnit. Without this exclusion the
    SDK's default **/*.cs glob pulls the test sources into the library build,
    which then fails on the missing xUnit reference.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
