<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Misar.Reach</RootNamespace>
    <AssemblyName>MisarReach</AssemblyName>

    <!-- NuGet metadata -->
    <PackageId>Misar.Reach</PackageId>
    <Version>1.0.0</Version>
    <Authors>Misar AI</Authors>
    <Company>Misar AI Technology Pvt Ltd</Company>
    <Description>Official C# SDK for MisarReach — lead finder (23 sources), multi-channel outreach, and CRM (deals, pipeline, sales agents). Full API coverage with async/await support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://misarreach.com/docs</PackageProjectUrl>
    <RepositoryUrl>https://misarreach.com</RepositoryUrl>
    <PackageTags>misarreach;leads;outreach;crm;sdk;api;sales</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Tests/ is its own project and references xUnit. Without this exclusion the
    SDK's default **/*.cs glob pulls the test sources into the library build,
    which then fails on the missing xUnit reference.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
